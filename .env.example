# Local development Docker profile.
# This profile allows dev seed data and relaxed CORS for local usage.
SPRING_PROFILES_ACTIVE=dev,docker

POSTGRES_DB=eshop
POSTGRES_USER=eshop
POSTGRES_PASSWORD=eshop
POSTGRES_PORT=5432

API_PORT=8282

# Local-only secret. Replace in real environments.
ESHOP_JWT_SECRET=local-development-secret-only-not-for-production-please-change-before-deploying
ESHOP_JWT_EXPIRATION_MINUTES=1440
ESHOP_REFRESH_TOKEN_EXPIRATION_DAYS=30

# Local development can use wildcard CORS.
CORS_ALLOWED_ORIGINS=*

# Keep false unless the app is behind a trusted reverse proxy.
ESHOP_TRUST_FORWARDED_HEADERS=false

ESHOP_AUTH_RATE_LIMIT_ENABLED=true
ESHOP_AUTH_RATE_LIMIT_LOGIN_CAPACITY=10
ESHOP_AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
ESHOP_AUTH_RATE_LIMIT_REFRESH_CAPACITY=30
ESHOP_AUTH_RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
ESHOP_AUTH_RATE_LIMIT_LOGOUT_CAPACITY=60
ESHOP_AUTH_RATE_LIMIT_LOGOUT_WINDOW_SECONDS=60
ESHOP_AUTH_RATE_LIMIT_CHANGE_PASSWORD_CAPACITY=5
ESHOP_AUTH_RATE_LIMIT_CHANGE_PASSWORD_WINDOW_SECONDS=300
# Production-like Docker profile.
# Do not use development seed credentials in this environment.
SPRING_PROFILES_ACTIVE=prod,docker

POSTGRES_DB=eshop
POSTGRES_USER=eshop
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_DATABASE_PASSWORD
POSTGRES_PORT=5432

API_PORT=8282

# Must be a real random secret with at least 64 characters.
# Do not use this placeholder value.
ESHOP_JWT_SECRET=CHANGE_THIS_TO_A_REAL_RANDOM_64_PLUS_CHARACTER_SECRET_BEFORE_RUNNING_PRODUCTION
ESHOP_JWT_EXPIRATION_MINUTES=60
ESHOP_REFRESH_TOKEN_EXPIRATION_DAYS=30

# Production must use explicit trusted origins.
CORS_ALLOWED_ORIGINS=https://admin.your-domain.com,https://api.your-domain.com

# Set true only when running behind a trusted reverse proxy like Nginx/Traefik.
ESHOP_TRUST_FORWARDED_HEADERS=false

ESHOP_AUTH_RATE_LIMIT_ENABLED=true
ESHOP_AUTH_RATE_LIMIT_LOGIN_CAPACITY=10
ESHOP_AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
ESHOP_AUTH_RATE_LIMIT_REFRESH_CAPACITY=30
ESHOP_AUTH_RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
ESHOP_AUTH_RATE_LIMIT_LOGOUT_CAPACITY=60
ESHOP_AUTH_RATE_LIMIT_LOGOUT_WINDOW_SECONDS=60
ESHOP_AUTH_RATE_LIMIT_CHANGE_PASSWORD_CAPACITY=5
ESHOP_AUTH_RATE_LIMIT_CHANGE_PASSWORD_WINDOW_SECONDS=300
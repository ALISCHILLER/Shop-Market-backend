# Production profile.
# Copy this file to .env on the production host and replace every CHANGE_ME value.

SPRING_PROFILES_ACTIVE=prod,docker
SPRING_DOCKER_COMPOSE_ENABLED=false

SERVER_PORT=8282
API_PORT=8282
SERVER_FORWARD_HEADERS_STRATEGY=framework

POSTGRES_DB=eshop
POSTGRES_USER=eshop
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://postgres:5432/eshop
DB_USERNAME=eshop
DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
DB_LEAK_DETECTION_THRESHOLD_MS=0

# Must be a real random secret, minimum 64 characters.
# Recommended: generate with a password manager or:
# openssl rand -base64 64
ESHOP_JWT_SECRET=CHANGE_ME_REAL_RANDOM_64_PLUS_CHARACTER_SECRET
ESHOP_JWT_EXPIRATION_MINUTES=60
ESHOP_REFRESH_TOKEN_EXPIRATION_DAYS=30

# Never use * in production.
# Example:
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=https://CHANGE_ME_ADMIN_DOMAIN

# Set true only when app is behind a trusted reverse proxy.
ESHOP_TRUST_FORWARDED_HEADERS=true

ESHOP_TAX_PERCENT=9

ESHOP_AUTH_RATE_LIMIT_ENABLED=true
ESHOP_AUTH_RATE_LIMIT_LOGIN_CAPACITY=5
ESHOP_AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
ESHOP_AUTH_RATE_LIMIT_REFRESH_CAPACITY=20
ESHOP_AUTH_RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
ESHOP_AUTH_RATE_LIMIT_LOGOUT_CAPACITY=30
ESHOP_AUTH_RATE_LIMIT_LOGOUT_WINDOW_SECONDS=60
ESHOP_AUTH_RATE_LIMIT_CHANGE_PASSWORD_CAPACITY=3
ESHOP_AUTH_RATE_LIMIT_CHANGE_PASSWORD_WINDOW_SECONDS=300

ROOT_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=WARN
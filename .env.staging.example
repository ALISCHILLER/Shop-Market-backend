SPRING_PROFILES_ACTIVE=staging,docker
SPRING_DOCKER_COMPOSE_ENABLED=false

SERVER_PORT=8282
API_PORT=8282
SERVER_FORWARD_HEADERS_STRATEGY=framework

POSTGRES_DB=eshop_staging
POSTGRES_USER=eshop_staging
POSTGRES_PASSWORD=CHANGE_ME_STRONG_STAGING_DATABASE_PASSWORD
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://postgres:5432/eshop_staging
DB_USERNAME=eshop_staging
DB_PASSWORD=CHANGE_ME_STRONG_STAGING_DATABASE_PASSWORD

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

ESHOP_JWT_SECRET=CHANGE_ME_REAL_RANDOM_64_PLUS_CHARACTER_STAGING_SECRET
ESHOP_JWT_EXPIRATION_MINUTES=60
ESHOP_REFRESH_TOKEN_EXPIRATION_DAYS=30

CORS_ALLOWED_ORIGINS=https://staging-admin.example.com
ESHOP_TRUST_FORWARDED_HEADERS=true
ESHOP_TAX_PERCENT=9

ESHOP_AUTH_RATE_LIMIT_ENABLED=true
ESHOP_AUTH_RATE_LIMIT_LOGIN_CAPACITY=10
ESHOP_AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
ESHOP_AUTH_RATE_LIMIT_REFRESH_CAPACITY=30
ESHOP_AUTH_RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
ESHOP_AUTH_RATE_LIMIT_LOGOUT_CAPACITY=60
ESHOP_AUTH_RATE_LIMIT_LOGOUT_WINDOW_SECONDS=60
ESHOP_AUTH_RATE_LIMIT_CHANGE_PASSWORD_CAPACITY=5
ESHOP_AUTH_RATE_LIMIT_CHANGE_PASSWORD_WINDOW_SECONDS=300

ROOT_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD